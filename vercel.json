{
  "buildCommand": "npx expo export --platform web && node scripts/pwa-inject.js",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/((?!_expo/|icons/|assets/|manifest.json|sw.js|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
