# Supabase credentials.
#
# Copy to `.env` and fill in from your project's API settings. With these unset,
# the app runs entirely against the demo dataset in src/data/demo.ts — no setup
# needed to see every screen.
#
# EXPO_PUBLIC_* variables are inlined into the client bundle, so only ever put
# the anon key here. The service-role key must never reach the app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay publishable key id (safe in the app). The SECRET goes only in the
# Supabase edge function via `supabase secrets set`, never here.
EXPO_PUBLIC_RAZORPAY_KEY_ID=
